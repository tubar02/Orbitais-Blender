        "z": "5376ca69f972b593",
        "name": "Preparar execução científica",
        "func": "const result = JSON.parse(msg.payload);\n\nif (!result.ok) {\n    node.error(result.error || \"Falha ao preparar Run\", msg);\n    return null;\n}\n\nmsg.run_id = result.run_id;\nmsg.run_dir = result.run_dir;\n\n// Argumento que será acrescentado ao próximo comando.\nmsg.payload = `\"${result.run_dir}\"`;\n\nreturn msg;",
