    {
        "id": "229605cb107cf954",
        "type": "function",
        "z": "8ebee22090835998",
        "name": "Preparar recuperação",
        "func": "\nconst data = msg.payload;\n\nif (!data || typeof data !== \"object\") {\n    node.error(\"Payload deve ser um objeto JSON.\", msg);\n    return null;\n}\n\nconst runId = String(data.run_id ?? \"\").trim();\n\nif (!/^run_\\d{8}_\\d{6}_[a-fA-F0-9]{8}$/.test(runId)) {\n    node.error(`ID de Run inválido: ${runId}`, msg);\n    return null;\n}\n\nif (data.confirm_stopped !== true) {\n    node.error(\n        \"Confirme que o processo anterior terminou.\",\n        msg\n    );\n    return null;\n}\n\nmsg.run_id = runId;\nmsg.run_dir = `runs/${runId}`;\n\nmsg.payload =\n    `\"${msg.run_dir}\" --confirm-stopped`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 160,
        "wires": [
            [
                "200fb8bb8669eadf"
            ]
        ]
    },
    {
        "id": "cfea6611c6ef7ae5",
        "type": "function",
        "z": "8ebee22090835998",
        "name": "Encaminhar retomada",
        "func": "const raw = String(msg.payload ?? \"\").trim();\n\nif (!raw) {\n    node.error(\"Recuperação sem resposta JSON.\", msg);\n    return null;\n}\n\nlet result;\n\ntry {\n    result = JSON.parse(raw);\n} catch (error) {\n    node.error(`JSON inválido: ${raw}`, msg);\n    return null;\n}\n\nif (!result.ok) {\n    node.error(\n        result.error || \"Falha na recuperação.\",\n        msg\n    );\n    return null;\n}\n\nmsg.run_id = result.run_id;\nmsg.run_dir = result.run_dir;\n\nconst stage = result.failed_stage;\n\nnode.status({\n    fill: \"blue\",\n    shape: \"dot\",\n    text: `Retomando ${stage}`\n});\n\nswitch (stage) {\n    case \"scientific\":\n        msg.payload =\n            `\"${msg.run_dir}\" --resume`;\n        return [msg, null, null];\n\n    case \"blender\":\n        msg.payload =\n            `--run \"${msg.run_dir}\" --save-blend --resume`;\n        return [null, msg, null];\n\n    case \"unity\":\n        msg.payload =\n            `\"${msg.run_dir}\" --resume`;\n        return [null, null, msg];\n\n    default:\n        node.error(\n            `Etapa desconhecida: ${stage}`,\n            msg\n        );\n        return null;\n}",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 80,
        "wires": [
            [],
            [],
            []
        ]
    },
