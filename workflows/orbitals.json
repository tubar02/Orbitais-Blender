        "name": "Preparar retomada unity",
        "func": "const runId = String(msg.payload).trim();\n\n// Aceita somente IDs no formato utilizado pelo projeto.\nconst pattern = /^run_\\d{8}_\\d{6}_[a-fA-F0-9]{8}$/;\n\nif (!pattern.test(runId)) {\n    node.error(`ID de Run inválido: ${runId}`, msg);\n    return null;\n}\n\nmsg.run_id = runId;\nmsg.run_dir = `runs/${runId}`;\n\n// O nó Unity Runner já possui:\n// python -m src.runners.unity_runner --run\nmsg.payload = `\"${msg.run_dir}\" --resume`;\n\nnode.status({\n    fill: \"blue\",\n    shape: \"dot\",\n    text: `Retomando ${runId}`\n});\n\nreturn msg;\n",
