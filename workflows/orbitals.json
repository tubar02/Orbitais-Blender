        "name": "Verificar científico",
        "func": "const result = msg.payload;\n\nif (result.code !== 0) {\n    node.error(\n        `Etapa científica falhou: código ${result.code}`,\n        msg\n    );\n    return null;\n}\n\nif (!msg.run_dir) {\n    node.error(\"Caminho da Run não encontrado.\", msg);\n    return null;\n}\n\nmsg.payload = `--run \"${msg.run_dir}\" --save-blend`;\n\nreturn msg;",
