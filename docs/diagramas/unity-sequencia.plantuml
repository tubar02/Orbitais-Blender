@startuml
!include estilo.iuml
skinparam maxMessageSize 175
hide footbox
participant "OrbitalRecording\nRunner" as Runner
participant "OrbitalRun\nImporter" as Importer
participant "OrbitalGif\nRecorder" as Gif
participant "Orbital\nPresenter" as Presenter
== Preparação da Run ==
Runner -> Importer : Importar FBXs da Run
Importer --> Runner : Bases e modos importados
Runner -> Runner : Ler job.json e iniciar Play Mode
Runner -> Presenter : Configurar apresentação
Runner -> Gif : Iniciar lote
== Gravação ==
loop Para cada orbital, base e modo do lote
  alt GIF válido já existe
    Gif -> Gif : Reaproveitar arquivo
  else Gravação necessária
    Gif -> Presenter : Carregar e enquadrar modelo
    Presenter --> Gif : Rotação configurada
    Gif -> Gif : Gravar a Game View e salvar GIF
  end
end
Gif --> Runner : Informar término do lote
@enduml
