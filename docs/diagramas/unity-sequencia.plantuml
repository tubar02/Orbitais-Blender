@startuml unity-sequencia-preparacao
!include estilo.iuml
skinparam maxMessageSize 0
skinparam sequenceMessageAlign center
hide footbox
participant "OrbitalRecording\nRunner" as Runner
participant "OrbitalRun\nImporter" as Importer
participant "OrbitalRun\nSettings" as Settings
participant "Orbital\nPresenter" as Presenter
Runner -> Importer : ImportRun(runDir)
Runner -> Settings : Load(runDir)
Runner -> Runner : Iniciar Play Mode
Runner -> Settings : Current.presentation
Runner -> Presenter : ConfigurePresentation(...)
@enduml

@startuml unity-sequencia-gravacao
!include estilo.iuml
skinparam maxMessageSize 0
skinparam sequenceMessageAlign center
hide footbox
participant "OrbitalRecording\nRunner" as Runner
participant "OrbitalGif\nRecorder" as Gif
participant "Orbital\nPresenter" as Presenter
participant "Rotation" as Rot
participant "OrbitalRun\nSettings" as Settings
Runner -> Gif : RecordBatch(bases, modes)
loop Para cada gravação necessária
    Gif -> Presenter : LoadOrbital(...)
    Presenter -> Rot : Criar e configurar
    Gif -> Presenter : Obter CurrentRotation
    Gif -> Rot : Ler velocidade e voltas
    Gif -> Settings : Current.recording
    Gif -> Gif : Calcular duração e gravar
    note over Presenter, Rot
      Unity executa Rotation.Update()
      durante a captura da Game View.
    end note
    Gif -> Gif : Encerrar captura e validar GIF
end
Gif --> Runner : RecordingFinished(success)
@enduml
